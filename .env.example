# ============================================
# APPLICATION
# ============================================

NODE_ENV=development
ENVIRONMENT=development

# ============================================
# FRONTEND
# ============================================

FRONTEND_PORT=3000
# URL Backend mà trình duyệt truy cập được sau khi backend publish ra host.
# Khi chạy Docker vẫn dùng localhost, không dùng http://backend:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Thời gian chờ request của frontend (mili giây)
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=15000

# ============================================
# BACKEND
# ============================================

BACKEND_PORT=8000

PORT=8000

AI_SERVICE_URL=http://localhost:8001

# Khi chạy Docker, dùng http://ai-service:8001

MONGODB_URI=mongodb://localhost:27017/fuel_consumption

# Khi chạy Docker, dùng mongodb://mongodb:27017/fuel_consumption

REQUEST_TIMEOUT_MS=10000
AI_SERVICE_TIMEOUT_MS=10000

# Phải trùng origin frontend, gồm scheme + host + port.
CORS_ORIGIN=http://localhost:3000

# ============================================
# AI SERVICE
# ============================================

AI_SERVICE_PORT=8001

MODEL_PATH=../models/model.joblib
SCHEMA_PATH=../models/schema.json
METADATA_PATH=../models/metadata.json

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info
